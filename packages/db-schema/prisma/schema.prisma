generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  status              TenantStatus         @default(pending)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  chatSessions        ChatSession[]
  marketplaceInstalls MarketplaceInstall[]
  orchestrationRuns   OrchestrationRun[]
  scheduledJobs       ScheduledJob[]
  users               TenantUser[]
  workspaces          Workspace[]
  branding            TenantBranding?
  ssoConfig           TenantSsoConfig?
}

model TenantSsoConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  enabled         Boolean  @default(false)
  provider        String   @default("saml")   // "saml" | "oidc"
  entryPoint      String                       // IdP SSO URL
  issuer          String                       // IdP entity ID / issuer
  cert            String                       // IdP public certificate (PEM)
  spEntityId      String                       // SP entity ID (our side)
  callbackUrl     String                       // ACS URL
  signatureAlgo   String   @default("sha256")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantBranding {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  companyName  String?
  logoUrl      String?
  primaryColor String?
  portalTitle  String?
  faviconUrl   String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model TenantUser {
  id             String    @id @default(cuid())
  tenantId       String
  email          String    @unique
  name           String
  passwordHash   String?   // null for SSO-only users
  role           String
  createdAt      DateTime  @default(now())
  // ── SSO ────────────────────────────────────────────────────────────────
  ssoProvider    String?   // "saml" | null
  ssoSubject     String?   // NameID from IdP assertion
  // ── MFA (TOTP) ─────────────────────────────────────────────────────────
  totpSecret     String?   // AES-256-GCM encrypted TOTP secret; null = MFA not configured
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime? // timestamp of last successful TOTP verification
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Workspace {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  status         WorkspaceStatus @default(pending)
  maxModeEnabled Boolean         @default(false)
  createdAt      DateTime        @default(now())
  bots           Bot[]
  sharedVm       WorkspaceVm?
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Bot {
  id               String             @id @default(cuid())
  workspaceId      String
  role             String
  status           BotStatus          @default(created)
  containerPort    Int?               // port on the shared workspace VM (null until provisioned)
  messagingEnabled Boolean            @default(true)  // false = this bot cannot send or receive A2A messages
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configVersions   BotConfigVersion[]
  persona          AgentPersona?
  sentMessages     AgentMessage[]     @relation("MessageFrom")
  receivedMessages AgentMessage[]     @relation("MessageTo")
}

model AgentPersona {
  id                  String   @id @default(cuid())
  botId               String   @unique
  tenantId            String
  displayName         String   @db.VarChar(100)
  emailAddress        String   @db.VarChar(255)
  avatarUrl           String?
  communicationStyle  String   @default("professional")
  disclosureStatement String   @default("This message was sent by an AI agent.")
  language            String   @default("en")
  timezone            String   @default("UTC")
  workingHours        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  bot                 Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Sprint 3 — Setup Wizard
model SetupWizardSession {
  id             String    @id @default(cuid())
  tenantId       String
  botId          String?
  currentStep    String    @default("select_role")
  completedSteps String[]  @default([])
  selectedRole   String?
  connectors     Json      @default("[]")
  personaBotId   String?
  approvalPolicy Json?
  status         String    @default("in_progress")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([tenantId])
  @@index([status])
}

model ProvisioningJob {
  id              String                @id @default(cuid())
  tenantId        String
  workspaceId     String
  botId           String
  planId          String
  runtimeTier     String
  roleType        String
  correlationId   String
  triggerSource   String
  status          ProvisioningJobStatus @default(queued)
  failureReason   String?
  remediationHint String?
  cleanupResult   String?
  requestedAt     DateTime
  requestedBy     String
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  metadata        String?
  orderId         String?
  triggeredBy     String?
  failedAt        DateTime?

  @@index([tenantId])
  @@index([workspaceId])
  @@index([correlationId])
}

// One shared VM per workspace — multiple bot containers run on it to save cost.
// When the last container is removed the VM is deprovisioned and this record is deleted.
model WorkspaceVm {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  tenantId             String
  vmName               String
  vmResourceId         String
  resourceGroup        String
  privateIp            String
  region               String
  vmSize               String    @default("Standard_B4ms")
  status               String    @default("running")
  activeContainerCount Int       @default(0)
  nextContainerPort    Int       @default(8081)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model RuntimeInstance {
  id              String        @id @default(cuid())
  botId           String        @unique
  workspaceId     String
  tenantId        String
  status          RuntimeStatus @default(created)
  contractVersion String
  endpoint        String?
  heartbeatAt     DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([workspaceId])
}

model BotCapabilitySnapshot {
  id                    String                   @id @default(cuid())
  botId                 String
  tenantId              String
  workspaceId           String
  roleKey               String
  roleVersion           String
  policyPackVersion     String
  allowedConnectorTools String[]
  allowedActions        String[]
  brainConfig           Json
  supportedLanguages    String[]                 @default(["en-US"])
  defaultLanguage       String                   @default("en-US")
  languageTier          String                   @default("base")
  speechProvider        String                   @default("oss")
  translationProvider   String                   @default("oss")
  ttsProvider           String                   @default("oss")
  avatarEnabled         Boolean                  @default(false)
  avatarStyle           String                   @default("audio-only")
  avatarProvider        String                   @default("none")
  avatarLocale          String                   @default("en-US")
  snapshotVersion       Int                      @default(1)
  snapshotChecksum      String?
  source                CapabilitySnapshotSource @default(runtime_freeze)
  frozenAt              DateTime
  createdAt             DateTime                 @default(now())

  @@unique([botId, snapshotVersion])
  @@index([tenantId])
  @@index([workspaceId])
  @@index([botId, frozenAt])
}

model ActionRecord {
  id                String       @id @default(cuid())
  tenantId          String
  workspaceId       String
  botId             String
  actionType        String
  riskLevel         RiskLevel
  policyPackVersion String
  inputSummary      String
  outputSummary     String?
  status            ActionStatus @default(pending)
  approvalId        String?
  connectorType     String?
  correlationId     String
  createdAt         DateTime     @default(now())
  completedAt       DateTime?

  @@index([tenantId])
  @@index([botId])
  @@index([correlationId])
}

model Approval {
  id                       String           @id @default(cuid())
  tenantId                 String
  workspaceId              String
  botId                    String
  taskId                   String
  actionId                 String
  riskLevel                RiskLevel
  actionSummary            String
  requestedBy              String
  approverId               String?
  decision                 ApprovalDecision @default(pending)
  decisionReason           String?
  decisionLatencySeconds   Int?
  policyPackVersion        String
  escalationTimeoutSeconds Int              @default(3600)
  escalatedAt              DateTime?
  createdAt                DateTime         @default(now())
  decidedAt                DateTime?
  llmModel                 String?
  llmProvider              String?
  delegatedToUserId        String?
  delegatedByUserId        String?
  delegatedAt              DateTime?
  delegationExpiresAt      DateTime?

  @@index([tenantId])
  @@index([workspaceId])
  @@index([botId])
  @@index([taskId])
  @@index([decision])
  @@index([riskLevel])
  @@index([decisionLatencySeconds])
  @@index([delegatedToUserId])
}

model AuditEvent {
  id            String         @id @default(cuid())
  tenantId      String
  workspaceId   String
  botId         String
  eventType     AuditEventType
  severity      AuditSeverity  @default(info)
  summary       String
  sourceSystem  String
  correlationId String
  createdAt     DateTime       @default(now())

  @@index([tenantId])
  @@index([botId])
  @@index([correlationId])
  @@index([createdAt])
}

model ConnectorAuthMetadata {
  id                String                @id @default(cuid())
  connectorId       String                @unique
  tenantId          String
  workspaceId       String
  connectorType     String
  displayName       String?
  authMode          String
  status            ConnectorAuthStatus   @default(not_configured)
  grantedScopes     String[]
  scopeStatus       ConnectorScopeStatus?
  secretRefId       String?
  tokenExpiresAt    DateTime?
  lastRefreshAt     DateTime?
  lastErrorClass    ConnectorErrorClass?
  lastHealthcheckAt DateTime?
  // C6.2 — OpenAPI tool catalog for self-describing Custom API connectors.
  // Stores CustomApiTool[] (parsed from the customer's OpenAPI spec) so the agent
  // runtime can inject it into the planner tool list, mirroring MCP tools/list.
  openapiCatalog    Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([tenantId])
  @@index([workspaceId])
  @@index([status])
}

model ConnectorAuthSession {
  id          String   @id @default(cuid())
  connectorId String
  tenantId    String
  workspaceId String
  stateNonce  String   @unique
  status      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([connectorId])
  @@index([tenantId])
}

model ConnectorAuthEvent {
  id            String               @id @default(cuid())
  connectorId   String
  tenantId      String
  eventType     String
  result        String
  errorClass    ConnectorErrorClass?
  correlationId String
  actor         String
  createdAt     DateTime             @default(now())

  @@index([connectorId])
  @@index([tenantId])
  @@index([correlationId])
}

model ConnectorAction {
  id                   String                    @id @default(cuid())
  actionId             String                    @unique
  tenantId             String
  workspaceId          String
  botId                String
  connectorId          String
  connectorType        String
  actionType           ConnectorActionType
  contractVersion      String                    @default("v1.0")
  correlationId        String
  requestBody          Json
  resultStatus         ConnectorActionStatus
  providerResponseCode String?
  resultSummary        String
  errorCode            ConnectorActionErrorCode?
  errorMessage         String?
  remediationHint      String?
  completedAt          DateTime
  createdAt            DateTime                  @default(now())

  @@index([tenantId])
  @@index([botId])
  @@index([correlationId])
  @@index([connectorType])
}

model TaskExecutionRecord {
  id               String               @id @default(cuid())
  botId            String
  tenantId         String
  workspaceId      String
  taskId           String
  modelProvider    String
  modelProfile     String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int
  outcome          TaskExecutionOutcome
  executedAt       DateTime
  createdAt        DateTime             @default(now())
  estimatedCostUsd Float?
  modelTier        String?
  platformFeeUsd   Float?
  taskPrompt       String?
  outputSummary    String?

  @@index([botId])
  @@index([tenantId])
  @@index([tenantId, executedAt])
  @@index([taskId])
}

model WorkspaceSessionState {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  version     Int
  state       Json
  updatedBy   String
  updatedAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([tenantId, workspaceId])
  @@index([tenantId])
  @@index([workspaceId])
}

model WorkspaceCheckpoint {
  id             String   @id @default(cuid())
  tenantId       String
  workspaceId    String
  sessionVersion Int
  label          String
  reason         String?
  stateDigest    String?
  actor          String
  createdAt      DateTime
  correlationId  String

  @@index([tenantId])
  @@index([workspaceId])
  @@index([tenantId, workspaceId])
  @@index([createdAt])
  @@index([correlationId])
}

model DesktopProfile {
  id            String    @id @default(cuid())
  tenantId      String
  workspaceId   String
  profileId     String    @unique
  browser       String
  storageRef    String?
  tabState      Json
  tokenVersion  Int       @default(1)
  lastRotatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, workspaceId])
  @@index([tenantId])
  @@index([workspaceId])
}

model IdeState {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  openFiles   Json     @default("[]")
  activeFile  String?
  breakpoints Json     @default("[]")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, workspaceId])
  @@index([tenantId])
  @@index([workspaceId])
}

model TerminalSession {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  shell       String   @default("bash")
  cwd         String   @default("/")
  lastCommand String?
  history     Json     @default("[]")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([workspaceId])
  @@index([tenantId, workspaceId])
}

model ActivityEvent {
  id            String    @id @default(cuid())
  tenantId      String
  workspaceId   String
  category      String
  title         String
  body          String?
  payload       Json?
  status        String    @default("unread")
  sequence      Int
  ackedAt       DateTime?
  ackedBy       String?
  correlationId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([workspaceId])
  @@index([tenantId, workspaceId, sequence])
  @@index([tenantId, workspaceId, status])
}

model EnvProfile {
  id              String    @id @default(cuid())
  tenantId        String
  workspaceId     String
  toolchain       Json      @default("[]")
  reconcileStatus String    @default("clean")
  lastReconcileAt DateTime?
  driftReport     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, workspaceId])
  @@index([tenantId])
  @@index([workspaceId])
}

model DesktopAction {
  id            String    @id @default(cuid())
  tenantId      String
  workspaceId   String
  actionType    String
  target        String?
  inputPayload  Json?
  result        String    @default("success")
  riskLevel     String    @default("low")
  retryClass    String    @default("retryable")
  retryCount    Int       @default(0)
  screenshotRef String?
  approvalId    String?
  errorMessage  String?
  completedAt   DateTime?
  correlationId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([workspaceId])
  @@index([tenantId, workspaceId])
  @@index([approvalId])
}

model PrDraft {
  id                 String   @id @default(cuid())
  tenantId           String
  workspaceId        String
  branch             String
  targetBranch       String?
  changeSummary      String
  linkedIssueIds     Json     @default("[]")
  title              String
  body               String
  checklist          Json     @default("[]")
  reviewersSuggested Json     @default("[]")
  status             String   @default("draft")
  prId               String?
  provider           String?
  labels             Json     @default("[]")
  correlationId      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, workspaceId])
  @@index([tenantId, workspaceId, status])
}

model CiTriageReport {
  id                  String   @id @default(cuid())
  tenantId            String
  workspaceId         String
  provider            String
  runId               String
  repo                String
  branch              String
  failedJobs          Json     @default("[]")
  logRefs             Json     @default("[]")
  status              String   @default("queued")
  rootCauseHypothesis String?
  reproSteps          Json?
  patchProposal       String?
  confidence          Float?
  blastRadius         String?
  correlationId       String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, workspaceId, runId])
  @@index([tenantId, workspaceId])
  @@index([tenantId, workspaceId, status])
}

model WorkMemory {
  id            String   @id @default(cuid())
  tenantId      String
  workspaceId   String
  memoryVersion Int      @default(1)
  entries       Json     @default("[]")
  summary       String?
  correlationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, workspaceId])
  @@index([tenantId, workspaceId])
}

model StoredEvidenceBundle {
  id            String    @id @default(cuid())
  taskId        String
  tenantId      String
  workspaceId   String
  botId         String
  actionType    String
  riskLevel     String
  routeDecision String
  llmProvider   String
  inputTokens   Int
  outputTokens  Int
  screenshots   String[]
  approvalId    String?
  signature     String?
  finalised     Boolean   @default(false)
  finalisedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([workspaceId])
  @@index([taskId])
  @@index([tenantId, workspaceId])
}

model RunResume {
  id            String   @id @default(cuid())
  tenantId      String
  workspaceId   String
  runId         String
  strategy      String
  resumedFrom   String?
  status        String   @default("queued")
  failureReason String?
  correlationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, workspaceId])
  @@index([tenantId, workspaceId, runId])
}

model ReproPack {
  id                 String   @id @default(cuid())
  tenantId           String
  workspaceId        String
  runId              String
  status             String   @default("generating")
  manifest           Json
  downloadRef        String?
  expiresAt          DateTime
  exportAuditEventId String?
  correlationId      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, workspaceId])
  @@index([tenantId, workspaceId, runId])
}

model AgentDispatchRecord {
  id                 String            @id @default(cuid())
  fromAgentId        String
  toAgentId          String
  workspaceId        String
  tenantId           String
  taskDescription    String
  status             String            @default("queued")
  wakeSource         String            @default("agent_handoff")
  queuedAt           DateTime          @default(now())
  createdAt          DateTime          @default(now())
  completedAt        DateTime?
  errorMessage       String?
  orchestrationRunId String?
  result             Json?
  subTaskIndex       Int?
  orchestrationRun   OrchestrationRun? @relation(fields: [orchestrationRunId], references: [id])

  @@index([tenantId, workspaceId])
  @@index([tenantId, queuedAt])
  @@index([orchestrationRunId])
}

model AgentBudgetConfig {
  id              String   @id @default(cuid())
  tenantId        String
  workspaceId     String
  botId           String   @unique
  dailyLimitUsd   Float?
  monthlyLimitUsd Float?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([workspaceId])
}

model AgentShortTermMemory {
  id               String    @id @default(cuid())
  workspaceId      String
  tenantId         String
  taskId           String
  actionsTaken     Json
  approvalOutcomes Json
  connectorsUsed   Json
  llmProvider      String?
  executionStatus  String    @default("success")
  summary          String
  correlationId    String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  repoName         String?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, expiresAt])
  @@index([tenantId])
}

model AgentLongTermMemory {
  id             String   @id @default(cuid())
  tenantId       String
  workspaceId    String
  pattern        String
  confidence     Float
  observedCount  Int      @default(1)
  lastSeen       DateTime
  createdAt      DateTime @default(now())
  repoName       String?
  // Sprint 4 — pgvector episodic memory
  botId          String?
  summary        String?
  embeddingModel String?
  embedding      Unsupported("vector(1536)")?

  @@unique([tenantId, pattern])
  @@index([workspaceId, confidence])
  @@index([tenantId, workspaceId])
  @@index([botId])
}

model AgentMemoryEdge {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  fromId      String
  fromType    String
  toId        String
  toType      String
  edgeType    String
  agentPrefix String?
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now())

  @@unique([tenantId, fromId, toId, edgeType])
  @@index([tenantId, workspaceId])
  @@index([tenantId, fromId, fromType])
  @@index([tenantId, toId, toType])
}

model AgentRepoKnowledge {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  repoName    String
  role        String
  key         String
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, repoName, role, key])
  @@index([tenantId, repoName, role])
  @@index([workspaceId])
}

model AgentSession {
  id                 String               @id @unique
  tenantId           String
  agentInstanceId    String
  taskId             String
  role               String
  recordingId        String
  recordingUrl       String
  startedAt          DateTime
  endedAt            DateTime?
  actionCount        Int                  @default(0)
  status             SessionAuditStatus   @default(running)
  failureReason      String?
  retentionExpiresAt DateTime?
  retentionPolicyId  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  actions            BrowserActionEvent[]

  @@index([tenantId])
  @@index([agentInstanceId])
  @@index([taskId])
  @@index([tenantId, startedAt])
  @@index([status])
  @@index([retentionExpiresAt])
}

model BrowserActionEvent {
  id                    String            @id @unique
  sessionId             String
  tenantId              String
  agentInstanceId       String
  sequence              Int
  actionType            BrowserActionType
  targetSelector        String
  targetText            String
  inputValue            String?
  pageUrl               String
  screenshotBeforeId    String
  screenshotAfterId     String
  screenshotBeforeUrl   String
  screenshotAfterUrl    String
  domSnapshotHashBefore String?
  domSnapshotHashAfter  String?
  networkLog            Json              @default("[]")
  durationMs            Int
  success               Boolean
  errorMessage          String?
  failureClass          String?
  timestamp             DateTime
  correctnessAssertion  Json?
  createdAt             DateTime          @default(now())
  session               AgentSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenantId])
  @@index([agentInstanceId])
  @@index([tenantId, actionType])
  @@index([timestamp])
  @@index([tenantId, timestamp])
}

model RetentionPolicy {
  id               String                @id @default(cuid())
  tenantId         String
  workspaceId      String?
  roleKey          String?
  name             String
  description      String?
  scope            RetentionPolicyScope  @default(tenant)
  action           RetentionPolicyAction @default(never_delete)
  retentionDays    Int?
  deletionTrigger  String?
  deletionSchedule String?
  effectiveFrom    DateTime
  expiredAt        DateTime?
  status           RetentionPolicyStatus @default(active)
  createdBy        String
  updatedBy        String
  correlationId    String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

