  botId             String
  prospectId        String
  title             String
  value             Float?
  currency          String    @default("USD")
  stage             DealStage @default(discovery)
  probability       Float?
  notes             String?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  contractSentAt    DateTime?
  contractSignedAt  DateTime?
  // External CRM IDs (written back after sync)
  hubspotDealId       String?
  salesforceDealId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  prospect   Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  activities SalesActivity[]

  @@index([tenantId])
  @@index([botId])
  @@index([prospectId])
  @@index([tenantId, stage])
}

model SalesActivity {
  id           String            @id @default(cuid())
  tenantId     String
  botId        String
  prospectId   String
  dealId       String?
  activityType SalesActivityType
  subject      String
  body         String?
  outcome      String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  prospect Prospect   @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  deal     SalesDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([botId])
  @@index([prospectId])
  @@index([dealId])
}

model Lead {
  id            String    @id @default(cuid())
  tenantId      String    @default("")
  firstName     String
  lastName      String?
  email         String
  company       String?
  message       String?
  leadSource    String?
  sfLeadId      String?
  status        String    @default("NEW")
  nurtureStep   Int       @default(0)
  lastContactAt DateTime?
  nextContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  nurtureEntries NurtureSequenceEntry[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@index([nextContactAt])
}

model NurtureSequenceEntry {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  step      Int
  channel   String   @default("email")
  subject   String?
  body      String?
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([step])
}

model SalesSequenceEntry {
  id           String    @id @default(cuid())
  tenantId     String
  botId        String
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequenceStep Int       @default(1)
  scheduledFor DateTime
  sentAt       DateTime?
  skipped      Boolean   @default(false)
  skipReason   String?
  subject      String?
  activityId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([botId])
  @@index([prospectId])
  @@index([scheduledFor])
  @@index([sentAt])
}

// ── CallRecord — cold call session (Twilio) ──────────────────────────────────

model CallRecord {
  id              String   @id @default(cuid())
  tenantId        String
  botId           String
  prospectId      String
  activityId      String?
  // Provider-agnostic call ID (written for all providers)
  callId          String?  @unique
  // Legacy Twilio-specific field — kept for backward compatibility
  twilioCallSid   String?  @unique
  provider        String   @default("twilio")      // twilio | signalwire | plivo | vonage
  status          String   @default("initiated")   // initiated|ringing|in-progress|completed|failed|no-answer|voicemail
  toNumber        String
  fromNumber      String
  durationSeconds Int?
  transcript      Json     @default("[]")          // CallTurn[]
  outcome         String?
  initiatedAt     DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([botId])
  @@index([prospectId])
  @@index([callId])
  @@index([twilioCallSid])
  @@index([tenantId, status])
}

// ── SalesNegotiation — pricing negotiation state ─────────────────────────────

model SalesNegotiation {
  id              String   @id @default(cuid())
  tenantId        String
  botId           String
  prospectId      String
  dealId          String?
  status          String   @default("open")        // open|accepted|rejected|escalated|expired
  listPrice       Float
  currency        String   @default("USD")
  currentOffer    Float
  counterOffer    Float?
  discountPercent Float?
  approvalRequired Boolean @default(false)
  approvalStatus  String?                          // pending|approved|rejected
  approverEmail   String?
  turns           Json     @default("[]")          // NegotiationTurn[]
  outcome         String?
  initiatedAt     DateTime @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prospect Prospect   @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([botId])
  @@index([prospectId])
  @@index([tenantId, status])
}

// ── SalesProposal — generated proposal documents ─────────────────────────────

model SalesProposal {
  id           String   @id @default(cuid())
  tenantId     String
  botId        String
  prospectId   String
  dealId       String?
  title        String
  htmlContent  String   @db.Text
