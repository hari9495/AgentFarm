model TenantPortalSession {
  id         String   @id @default(cuid())
  accountId  String
  tenantId   String
  token      String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account TenantPortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
}

// ── Agent messaging model ─────────────────────────────────────────────────────

model AgentMessage {
  id          String    @id @default(cuid())
  fromBotId   String?
  toBotId     String?
  messageType String    @default("info")
  subject     String?
  body        String
  status      String    @default("sent")
