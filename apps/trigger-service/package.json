{
    "name": "@agentfarm/trigger-service",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/main.ts",
    "types": "./src/main.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "node --import tsx src/main.ts",
