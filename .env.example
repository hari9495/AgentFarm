# =============================================================================
# AgentFarm — consolidated environment variable reference
# Copy this file to .env and fill in values for your environment.
# Vars marked AF_* also accept an AGENTFARM_* alias as a fallback unless noted.
#
# SECURITY RULES:
#   - NEVER commit .env (it is gitignored)
#   - NEVER paste real secrets into chat or code reviews
#   - Use DIFFERENT keys for dev vs prod (see .env.production.example)
#   - Rotate any secret that may have been exposed before going live
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose profiles
# -----------------------------------------------------------------------------
# The default `docker compose up` starts the core stack only (postgres, redis,
# opa, api-gateway, agent-runtime, trigger-service, dashboard, desktop-agent,
# meeting-agent, voxcpm).
#
# Add COMPOSE_PROFILES=voice to activate the self-hosted open-source voice stack:
#   whisper     — Faster-Whisper STT (99 languages, zero per-call cost)
#   kokoro      — Kokoro-FastAPI TTS (English, OpenAI-compatible, zero cost)
#   freeswitch  — FreeSWITCH SIP server (universal meeting dial-in)
#
# These three services replace paid APIs (Sarvam AI, Deepgram, Twilio) with
# self-hosted alternatives. First boot downloads models (~1.8 GB total).
#
# Usage:
#   COMPOSE_PROFILES=voice   → include voice services on every `docker compose up`
#   docker compose --profile voice up   → one-off with voice services
#
COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# Shared / Infrastructure
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by all services that write to the DB.
# DEV: use a local DB named 'agentfarm' — never the same DB as production.
# PROD: append ?sslmode=require to enforce TLS in transit. Azure Database for
#       PostgreSQL enforces SSL server-side by default, but the client must
#       request it explicitly. Azure Transparent Data Encryption (TDE) provides
#       encryption at rest for the underlying disk — no additional config needed
#       when using Azure Database for PostgreSQL Flexible Server.
DATABASE_URL=postgresql://agentfarm:your-secret-here@localhost:5432/agentfarm
# Production example (add SSL + Azure host):
# DATABASE_URL=postgresql://agentfarm@your-server.postgres.database.azure.com:5432/agentfarm_prod?sslmode=require

# Password for the local postgres service (used by docker-compose).
# Change from the default — even in development.
POSTGRES_PASSWORD=your-secret-here

# Redis connection string used for caching and pub/sub
REDIS_URL=redis://localhost:6379

# OPA (Open Policy Agent) base URL for policy evaluation
OPA_BASE_URL=http://localhost:8181

# -----------------------------------------------------------------------------
# api-gateway  (apps/api-gateway)
# -----------------------------------------------------------------------------

# Port the API gateway HTTP server listens on
API_GATEWAY_PORT=3000

# Set to "true" to enforce bearer-token auth on all routes
API_REQUIRE_AUTH=false

# Secret used to sign session cookies; change this in production
API_SESSION_SECRET=your-secret-here

# MFA (TOTP) — required when users enroll in Multi-Factor Authentication
# MFA_ENCRYPTION_KEY: ≥32 chars; AES-256-GCM encrypts TOTP secrets at rest
# MFA_ISSUER: label shown in the user's authenticator app (e.g. Google Authenticator)
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-minimum-32-chars
MFA_ISSUER=AgentFarm

# Field-level encryption — AES-256-GCM for sensitive columns in the database
# (telephony auth tokens, third-party API keys, webhook secrets).
# Derives a 32-byte AES key via HMAC-SHA256("agentfarm-field-v1").
# Without this key, those fields are stored as plaintext. Set before first write.
# After setting, run scripts/migrate-encrypt-fields.ts to encrypt existing rows.
# Minimum length: 32 characters. Generate: openssl rand -base64 48
FIELD_ENCRYPTION_KEY=your-field-encryption-key-minimum-32-chars

# Comma-separated allowed CORS origins.
# PRODUCTION: set to your exact domain(s) — NEVER use * or leave unset.
# Example production value: ALLOWED_ORIGINS=https://app.agentfarm.ai,https://dashboard.agentfarm.ai
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Bearer token required for /ops/monitoring endpoints
OPS_MONITORING_TOKEN=your-secret-here

# Feature flag: allow loading external plugins at runtime
FEATURE_EXTERNAL_PLUGIN_LOADING=false

# Base URL of the orchestrator service (used by handoff routes)
ORCHESTRATOR_API_BASE_URL=http://localhost:3011

# Path where the orchestrator persists scheduler state (task runs, routines, handoffs).
# Must point to a directory that survives restarts — use a Docker volume or mounted path.
# Default (.orchestrator/state.json) is relative and ephemeral inside containers.
ORCHESTRATOR_STATE_PATH=/data/orchestrator/state.json

# Base URL of the agent-runtime service (used by chat proxy and schedule proxy routes)
AGENT_RUNTIME_URL=http://localhost:4000

# Shared token that agent-runtime uses to authenticate inbound calls to the gateway
RUNTIME_SERVICE_TOKEN=your-secret-here

# Shared token for the approval intake endpoint (canonical: AGENTFARM_APPROVAL_INTAKE_SHARED_TOKEN; AF_APPROVAL_INTAKE_SHARED_TOKEN accepted as fallback)
APPROVAL_INTAKE_SHARED_TOKEN=your-secret-here

# Shared token for runtime decision callbacks (canonical: AGENTFARM_RUNTIME_DECISION_SHARED_TOKEN; RUNTIME_DECISION_SHARED_TOKEN accepted as fallback)
RUNTIME_DECISION_SHARED_TOKEN=your-secret-here

# Shared token for connector execution callbacks (canonical: AGENTFARM_CONNECTOR_EXEC_SHARED_TOKEN; CONNECTOR_EXEC_SHARED_TOKEN accepted as fallback)
CONNECTOR_EXEC_SHARED_TOKEN=your-secret-here

# Shared token used when dispatching tasks to the runtime (canonical: AGENTFARM_RUNTIME_DISPATCH_SHARED_TOKEN; AF_RUNTIME_DISPATCH_SHARED_TOKEN accepted as fallback)
RUNTIME_DISPATCH_SHARED_TOKEN=your-secret-here

# Shared token for runtime-task observability push (canonical: AGENTFARM_RUNTIME_TASK_SHARED_TOKEN; RUNTIME_TASK_SHARED_TOKEN accepted as fallback)
RUNTIME_TASK_SHARED_TOKEN=your-secret-here

# Shared token for passwordless (OTP / magic-link) login — used by Next.js auth routes to call the API gateway
PASSWORDLESS_LOGIN_SHARED_TOKEN=your-secret-here

# Bearer token protecting the SSE internal-push endpoint
SSE_INTERNAL_TOKEN=your-secret-here

# URL of the SSE push endpoint used by internal services to broadcast events
SSE_PUSH_URL=http://localhost:3001/sse-push

# Slack incoming webhook URL for agent-question escalation notifications
AGENT_QUESTION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Meeting summary → Slack distribution (set to "true" to enable)
MEETING_SLACK_DISTRIBUTION=false
MEETING_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# HMAC secret for generic inbound webhooks
WEBHOOK_INGEST_SECRET=your-secret-here

# HMAC secret for Slack inbound webhooks
SLACK_WEBHOOK_SECRET=your-secret-here

# HMAC secret for Microsoft Teams inbound webhooks
TEAMS_WEBHOOK_SECRET=your-secret-here

# Azure Bot registration credentials — required for Teams outbound replies
# Create an Azure Bot resource, then copy the App ID and generate a client secret.
# Docs: https://learn.microsoft.com/en-us/azure/bot-service/bot-service-quickstart-registration
TEAMS_BOT_APP_ID=your-azure-bot-app-id
TEAMS_BOT_APP_PASSWORD=your-azure-bot-client-secret

# Google Chat reply credentials — required for Google Chat trigger outbound replies
# Create a Service Account in Google Cloud Console with chat.messages.create scope,
# or use an OAuth2 access token. The token is passed per-event by the Google Chat adapter.
# Docs: https://developers.google.com/chat/api/guides/auth/service-accounts
GOOGLE_CHAT_SERVICE_ACCOUNT_TOKEN=your-service-account-token

# HMAC secret for memory-sync inbound webhooks
MEMORY_WEBHOOK_SECRET=your-secret-here

# Comma-separated domains allowed for internal login (deny-all if unset)
API_INTERNAL_LOGIN_ALLOWED_DOMAINS=agentfarm.local

# Comma-separated roles granted admin access via internal login
API_INTERNAL_LOGIN_ADMIN_ROLES=admin

# Azure Application Insights connection string (shared with agent-runtime)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string-here

# OpenTelemetry OTLP exporter endpoint (shared with agent-runtime)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# agent-runtime — identity & control-plane binding  (apps/agent-runtime)
# -----------------------------------------------------------------------------

# Unique tenant identifier for this runtime instance
AF_TENANT_ID=your-tenant-id

# Tenant identifier used by agent-runtime main process (simple string; defaults to "default")
AGENT_TENANT_ID=default

# Unique workspace identifier for this runtime instance
AF_WORKSPACE_ID=your-workspace-id

# Unique bot/agent identifier for this runtime instance
AF_BOT_ID=your-bot-id

# Role profile name (e.g. "Developer Agent"); drives policy key resolution
AF_ROLE_PROFILE=Developer Agent

# Optional explicit role key override; derived from AF_ROLE_PROFILE if unset
AF_ROLE_KEY=

# Role definition version string
AF_ROLE_VERSION=1.0

# Policy pack version to enforce (e.g. "mvp-v1")
AF_POLICY_PACK_VERSION=mvp-v1

# URL of the approval API (control plane); used for approval intake and heartbeat fallback
AF_APPROVAL_API_URL=http://localhost:3000

# URL of the evidence storage API
AF_EVIDENCE_API_URL=http://localhost:3005

# Optional URL of the connector API; falls back to AF_APPROVAL_API_URL
AF_CONNECTOR_API_URL=

# Optional explicit heartbeat URL; falls back to AF_APPROVAL_API_URL
AF_CONTROL_PLANE_HEARTBEAT_URL=

# Log verbosity level (e.g. "info", "debug", "warn")
AF_LOG_LEVEL=info

# Contract version tag sent with every runtime payload
AF_RUNTIME_CONTRACT_VERSION=1.0

# Optional correlation ID injected into telemetry (defaults to "unknown")
AF_CORRELATION_ID=

# Legacy/fallback port var consulted only if RUNTIME_PORT is unset (the runtime serves
# its health-check endpoint on the same single HTTP server as the rest of its API — there
# is no separate health port). Set this to the SAME value as RUNTIME_PORT, or leave it
# unset and rely on RUNTIME_PORT. Mismatched values here will cause the runtime to bind
# to the wrong port relative to what AGENT_RUNTIME_URL / RUNTIME_BASE_URL advertise.
AF_HEALTH_PORT=4000

# Set to "true" to enforce task lease locking
AF_ENFORCE_TASK_LEASE=false

# Lease TTL in seconds when task lease locking is enabled
AF_TASK_LEASE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# agent-runtime — connectivity
# -----------------------------------------------------------------------------

# Port the agent-runtime HTTP server listens on
RUNTIME_PORT=4000

# Externally reachable base URL of this runtime (auto-derived from RUNTIME_PORT if unset)
RUNTIME_BASE_URL=http://localhost:4000

# Base URL of the API gateway (used for callbacks and approval intake)
API_GATEWAY_URL=http://localhost:3000

# URL of the multi-agent dispatch endpoint (optional; enables agent-to-agent dispatch)
AGENT_DISPATCH_URL=http://localhost:3001/dispatch

# URL of the evidence service
EVIDENCE_SERVICE_URL=http://localhost:3005

# Bearer token for authenticating to the evidence service
EVIDENCE_SERVICE_TOKEN=your-secret-here

# Service token for meeting-agent RAG flywheel — authenticated calls to the
# api-gateway knowledge-base and lesson-pipeline endpoints.
# Set this (along with API_GATEWAY_URL above) to enable prior-meeting context
# retrieval and post-meeting summary ingestion for the meeting-agent.
MEETING_SERVICE_TOKEN=your-secret-here

# -----------------------------------------------------------------------------
# agent-runtime — desktop operator
# -----------------------------------------------------------------------------

# Desktop automation provider: "native" (default) or "playwright"
DESKTOP_OPERATOR=native

# Optional session ID passed to the desktop operator
DESKTOP_OPERATOR_SESSION_ID=

# Local directory for browser session profiles used by the desktop operator
BROWSER_PROFILE_DIR=./data/browser-profiles

# URL of the chrome-devtools-mcp HTTP bridge (bridged via supergateway).
# In Docker (desktop-agent container) this is set automatically to http://localhost:3100/mcp.
# For local development: run `npx chrome-devtools-mcp | npx supergateway --port 3100`
# then set this variable. Leave empty to use Playwright-only browser automation.
MCP_CHROME_DEVTOOLS_URL=http://localhost:3100/mcp

# -----------------------------------------------------------------------------
# agent-runtime — LLM provider  (set AF_MODEL_PROVIDER to activate one)
# -----------------------------------------------------------------------------

# LLM provider selection: openai | anthropic | azure_openai | google | xai | mistral | together | github_models | auto
AF_MODEL_PROVIDER=anthropic

# LLM request timeout in milliseconds (optional)
AF_LLM_TIMEOUT_MS=60000

# Default model profile pin (optional — leave unset to let task complexity auto-select the tier).
# When set, overrides automatic selection and pins ALL classification calls to that tier.
# Only set this if you intentionally want every call to use the same tier.
# Allowed values: quality_first | speed_first | cost_balanced
# AF_DEFAULT_MODEL_PROFILE=quality_first

# --- OpenAI ---
# Built-in tier defaults (apply when per-tier vars below are not set):
#   quality_first → gpt-4o   cost_balanced → gpt-4o   speed_first → gpt-4o-mini
AF_OPENAI_API_KEY=your-secret-here
AF_OPENAI_BASE_URL=https://api.openai.com/v1
AF_OPENAI_MODEL=gpt-4o
# Per-complexity model overrides (optional):
# AF_OPENAI_MODEL_QUALITY_FIRST=gpt-4o
# AF_OPENAI_MODEL_COST_BALANCED=gpt-4o
# AF_OPENAI_MODEL_SPEED_FIRST=gpt-4o-mini

# --- Anthropic ---
# Built-in tier defaults (apply when per-tier vars below are not set):
#   quality_first → claude-opus-4-7   cost_balanced → claude-sonnet-4-6   speed_first → claude-haiku-4-5
AF_ANTHROPIC_API_KEY=your-secret-here
AF_ANTHROPIC_BASE_URL=https://api.anthropic.com
AF_ANTHROPIC_MODEL=claude-sonnet-4-6
# Per-complexity model overrides (optional):
# AF_ANTHROPIC_MODEL_QUALITY_FIRST=claude-opus-4-7
# AF_ANTHROPIC_MODEL_COST_BALANCED=claude-sonnet-4-6
# AF_ANTHROPIC_MODEL_SPEED_FIRST=claude-haiku-4-5

# --- Azure OpenAI ---
AF_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AF_AZURE_OPENAI_API_KEY=your-secret-here
AF_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Google AI ---
# Built-in tier defaults: quality_first → gemini-1.5-pro   speed_first → gemini-1.5-flash
AF_GOOGLE_API_KEY=your-secret-here
AF_GOOGLE_MODEL=gemini-1.5-flash
# AF_GOOGLE_MODEL_QUALITY_FIRST=gemini-1.5-pro
# AF_GOOGLE_MODEL_SPEED_FIRST=gemini-1.5-flash

# --- xAI ---
AF_XAI_API_KEY=your-secret-here
AF_XAI_MODEL=grok-beta

# --- Mistral ---
# Built-in tier defaults: quality_first → mistral-large-latest   speed_first → mistral-small-latest
AF_MISTRAL_API_KEY=your-secret-here
AF_MISTRAL_MODEL=mistral-small-latest
# AF_MISTRAL_MODEL_QUALITY_FIRST=mistral-large-latest
# AF_MISTRAL_MODEL_SPEED_FIRST=mistral-small-latest

# --- Together AI ---
# Built-in tier defaults: quality_first → 70B   speed_first → 8B
AF_TOGETHER_API_KEY=your-secret-here
AF_TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
# AF_TOGETHER_MODEL_QUALITY_FIRST=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# AF_TOGETHER_MODEL_SPEED_FIRST=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# --- DeepSeek ---
# Built-in tier defaults: quality_first → deepseek-reasoner   speed_first → deepseek-chat
AF_DEEPSEEK_API_KEY=your-secret-here
AF_DEEPSEEK_BASE_URL=https://api.deepseek.com
AF_DEEPSEEK_MODEL=deepseek-chat
# AF_DEEPSEEK_MODEL_QUALITY_FIRST=deepseek-reasoner
# AF_DEEPSEEK_MODEL_SPEED_FIRST=deepseek-chat
# AF_DEEPSEEK_MODEL_COST_BALANCED=deepseek-chat

# --- GitHub Models ---
# Built-in tier defaults: quality_first → gpt-4o   speed_first → gpt-4o-mini
AF_GITHUB_MODELS_API_KEY=your-secret-here
AF_GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
AF_GITHUB_MODELS_MODEL=gpt-4o-mini

# --- NVIDIA Build (OpenAI-compatible) ---
# 1 000 free API calls/month per model. Get key: https://build.nvidia.com → Sign In → API Keys
# To activate: set AF_MODEL_PROVIDER=openai and uncomment the three lines below.
# Full model catalog: https://build.nvidia.com/models
#
# Recommended profiles:
#   quality_first  → nvidia/llama-3.1-nemotron-ultra-253b-v1   (best reasoning)
#   cost_balanced  → nvidia/llama-3.3-nemotron-super-49b-v1    (fast + capable)
#   speed_first    → microsoft/phi-4-mini-instruct             (ultra cheap)
#
# Other notable models available on NVIDIA Build:
#   deepseek-ai/deepseek-r1                       671B MoE — strong reasoning
#   deepseek-ai/deepseek-r1-distill-llama-70b     70B  — cheaper R1 quality
#   deepseek-ai/deepseek-v3-0324                  685B MoE — fast general
#   meta/llama-3.1-405b-instruct                  405B — high quality chat
#   meta/llama-3.3-70b-instruct                   70B  — solid general purpose
#   meta/llama-3.1-8b-instruct                    8B   — cheapest Llama
#   mistralai/mistral-large-2-instruct            123B — sales/proposals
#   qwen/qwen2.5-72b-instruct                     72B  — multi-language
#   qwen/qwen2.5-coder-32b-instruct               32B  — code tasks
#   microsoft/phi-4                               14B  — light/speed tasks
#   meta/llama-3.2-90b-vision-instruct            90B  — multimodal
#
# AF_OPENAI_API_KEY=nvapi-your-key-here
# AF_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# AF_OPENAI_MODEL_QUALITY_FIRST=nvidia/llama-3.1-nemotron-ultra-253b-v1
# AF_OPENAI_MODEL_COST_BALANCED=nvidia/llama-3.3-nemotron-super-49b-v1
# AF_OPENAI_MODEL_SPEED_FIRST=microsoft/phi-4-mini-instruct

# --- Chat LLM (Phase 13 — Agent Chat; used by chat-service.ts) ---
# Provider selection for the multi-turn chat feature: "mock" (default) | any OpenAI-compatible provider
LLM_PROVIDER=mock

# Base URL of the OpenAI-compatible chat endpoint used by the chat service
LLM_BASE_URL=http://localhost:11434

# API key for the chat LLM endpoint (leave empty when running Ollama locally)
LLM_API_KEY=

# Model name to request from the chat LLM endpoint
LLM_MODEL=llama3

# Request timeout in milliseconds for chat LLM calls (default 30000)
LLM_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# agent-runtime — token budget
# -----------------------------------------------------------------------------

# Path to the persisted token-budget state JSON file
AF_TOKEN_BUDGET_STATE_PATH=./data/token-budget-state.json

# Daily token spend limit (integer; unset = unlimited — MUST be set before launch)
# A sensible starting point: 500 000 tokens/day per bot covers ~1 000 typical tasks.
# Scope: per tenant:workspace:bot combination. Raise deliberately per bot as needed.
# At 80% consumed a warning is emitted; at 100% tasks route to approval instead of executing.
AF_TOKEN_BUDGET_DAILY_LIMIT=500000

# Fraction of daily limit at which a warning is emitted (default 0.8)
AF_TOKEN_BUDGET_WARNING_THRESHOLD=0.8

# Fraction of daily limit at which tasks are critically throttled (default 0.9)
AF_TOKEN_BUDGET_CRITICAL_THRESHOLD=0.9

# Budget alert thresholds for api-gateway budget-policy route (percentage of daily limit)
# Warn at 80%, critical alert at 90%, exceeded alert at 100%. Override per environment.
BUDGET_ALERT_WARN_PCT=80
BUDGET_ALERT_CRITICAL_PCT=90
BUDGET_ALERT_EXCEEDED_PCT=100

# -----------------------------------------------------------------------------
# agent-runtime — observability & blob storage
# -----------------------------------------------------------------------------

# Local SQLite path for action observability when blob storage is not configured
AGENT_OBSERVABILITY_DB_PATH=./data/observability.db

# Azure Blob Storage account URL for action observability uploads
AGENT_OBSERVABILITY_BLOB_ACCOUNT_URL=https://youraccount.blob.core.windows.net

# Blob container name for action observability
AGENT_OBSERVABILITY_BLOB_CONTAINER=agentfarm-observability

# SAS token with write access to the observability container
AGENT_OBSERVABILITY_BLOB_WRITE_SAS_TOKEN=your-secret-here

# SAS token with read access to the observability container
AGENT_OBSERVABILITY_BLOB_READ_SAS_TOKEN=your-secret-here

# -----------------------------------------------------------------------------
# api-gateway — audit event blob storage
# -----------------------------------------------------------------------------

# Azure Storage connection string for audit event JSON uploads (api-gateway audit-writer)
# Get from Azure Portal → Storage Account → Access Keys → Connection string
# Leave unset to skip Blob upload (audit is always stored in the database)
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=your-key;EndpointSuffix=core.windows.net

# Blob container name for audit event JSON records
AZURE_BLOB_CONTAINER_NAME=agentfarm-audit

# Optional: separate container for evidence/approval artifact uploads
AZURE_BLOB_EVIDENCE_CONTAINER_NAME=agentfarm-evidence

# -----------------------------------------------------------------------------
# agent-runtime — notification webhooks
# -----------------------------------------------------------------------------

# Slack incoming webhook URL for runtime event notifications
NOTIFICATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Microsoft Teams incoming webhook URL for runtime event notifications
NOTIFICATION_TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/your/url

# Notification channel to use: slack | email | webhook
NOTIFICATION_CHANNEL=slack

# Generic outbound webhook URL (used when NOTIFICATION_CHANNEL=webhook)
NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email notification recipient (required when NOTIFICATION_CHANNEL=email)
NOTIFICATION_EMAIL_TO=alerts@yourdomain.com

# Email notification sender address (required when NOTIFICATION_CHANNEL=email)
NOTIFICATION_EMAIL_FROM=agentfarm@yourdomain.com

# SMTP server hostname (required when NOTIFICATION_CHANNEL=email)
NOTIFICATION_SMTP_HOST=smtp.yourdomain.com

# SMTP server port (required when NOTIFICATION_CHANNEL=email)
NOTIFICATION_SMTP_PORT=587

# -----------------------------------------------------------------------------
# trigger-service  (apps/trigger-service)
# -----------------------------------------------------------------------------

# Port the trigger-service HTTP server listens on
TRIGGER_SERVICE_PORT=3002

# Path to a JSON file containing full TriggerServiceConfig (highest priority)
TRIGGER_CONFIG_PATH=

# Inline JSON TriggerServiceConfig string (second priority after TRIGGER_CONFIG_PATH)
TRIGGER_CONFIG=

# Single-tenant fallback: tenant identifier
TRIGGER_TENANT_ID=default

# Single-tenant fallback: default agent to route triggers to
TRIGGER_DEFAULT_AGENT_ID=default-agent

# URL of the agent-runtime instance triggers are dispatched to
AGENT_RUNTIME_URL=http://localhost:4000

# Anthropic API key used by trigger-service for AI-assisted routing
ANTHROPIC_API_KEY=your-secret-here

# Anthropic API version used by trigger-service
ANTHROPIC_API_VERSION=2023-06-01

# HMAC secret for verifying inbound webhook signatures (x-hub-signature-256 / x-signature)
WEBHOOK_HMAC_SECRET=your-secret-here

# --- Email trigger source (optional; enabled when EMAIL_IMAP_HOST is set) ---
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_TLS=true
EMAIL_IMAP_USER=agent@example.com
EMAIL_IMAP_PASSWORD=your-secret-here

# --- Slack trigger source (optional; enabled when SLACK_BOT_TOKEN is set) ---
SLACK_BOT_TOKEN=your-secret-here
SLACK_SIGNING_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# website / access control  (apps/website)
# See apps/website/.env.example for the full website-specific variable list.
# Variables below are the subset also consumed at the platform level.
# -----------------------------------------------------------------------------

# Comma-separated superadmin email addresses
AGENTFARM_SUPERADMIN_EMAILS=

# Comma-separated superadmin email domains
AGENTFARM_SUPERADMIN_DOMAINS=

# Comma-separated admin email addresses
AGENTFARM_ADMIN_EMAILS=

# Comma-separated admin email domains
AGENTFARM_ADMIN_DOMAINS=

# Comma-separated company member email addresses
AGENTFARM_COMPANY_EMAILS=

# Comma-separated company member email domains
AGENTFARM_COMPANY_DOMAINS=

# Fallback domain treated as company member when AGENTFARM_DISABLE_COMPANY_FALLBACK is false
AGENTFARM_COMPANY_FALLBACK_DOMAINS=agentfarm.local

# Set to "true" to disable the company fallback domain
AGENTFARM_DISABLE_COMPANY_FALLBACK=false

# Internal URL of the dashboard shown to company members
AGENTFARM_INTERNAL_DASHBOARD_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# dashboard  (apps/dashboard)
# -----------------------------------------------------------------------------

# API gateway base URL used by Next.js proxy routes inside the dashboard
DASHBOARD_API_BASE_URL=http://localhost:3000

# Meeting-agent service URL — used by /api/meeting-agent/* dashboard proxy routes
# for live controls (join, stop, real-time transcript, in-meeting chat).
# Docker: http://meeting-agent:7799  |  Local dev: http://localhost:7799
MEETING_AGENT_URL=http://meeting-agent:7799
# Optional bearer token matching MEETING_AGENT_TOKEN on the meeting-agent service
MEETING_AGENT_TOKEN=

# Public-facing API URL consumed by browser-side code in dashboard and website
NEXT_PUBLIC_API_URL=http://localhost:3000

# Comma-separated emails explicitly allowed to sign up
AGENTFARM_ALLOWED_SIGNUP_EMAILS=

# Comma-separated domains explicitly allowed to sign up
AGENTFARM_ALLOWED_SIGNUP_DOMAINS=

# -----------------------------------------------------------------------------
# Connectors / External Services
# -----------------------------------------------------------------------------

# SMTP host for outbound email notifications
SMTP_HOST=smtp.example.com

# SMTP port
SMTP_PORT=587

# SMTP username
SMTP_USER=user@example.com

# SMTP password
SMTP_PASS=your-secret-here

# From address used in outbound emails sent by trigger-service and connector-gateway
SMTP_FROM=noreply@agentfarm.dev

# -----------------------------------------------------------------------------
# Sales Agent — Lead Source Providers
# -----------------------------------------------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=

# -----------------------------------------------------------------------------
# Sales Agent — Lead Source Providers
# Set the key(s) for whichever provider(s) you want the sales agent to use.
# Provider is selected via LeadSourceProvider in the task payload.
# -----------------------------------------------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=
LINKEDIN_API_KEY=
CLEARBIT_API_KEY=
ZOOMINFO_CLIENT_ID=
ZOOMINFO_CLIENT_SECRET=
ZOOMINFO_API_KEY=
LUSHA_API_KEY=
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=

# -----------------------------------------------------------------------------
# Sales Agent — Email Providers
# (SMTP vars above are reused for smtp provider — set SMTP_HOST/PORT/USER/PASS)
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=
MAILGUN_API_KEY=
SALES_EMAIL_FROM=sales@yourdomain.com
SALES_EMAIL_FROM_NAME=

# Base URL of the Voicebox service for voice interaction
VOICEBOX_URL=http://voicebox:17493

# Base URL of the VoxCPM2 voice synthesis service
VOXCPM2_URL=http://localhost:8765

# Model ID served by the Voicebox / VoxCPM2 service
VOXCPM2_MODEL_ID=openbmb/VoxCPM2

# -----------------------------------------------------------------------------
# Open-source self-hosted voice providers (zero per-call cost)
# Activate with: COMPOSE_PROFILES=voice  (see top of this file)
# -----------------------------------------------------------------------------

# Whisper STT — Faster-Whisper server (OpenAI-compatible /v1/audio/transcriptions)
# Docker: http://whisper:8000  |  Local dev: http://localhost:9090
# Model options: tiny / base / small / medium (default) / large-v3
#   medium  = good balance, ~1.5 GB VRAM/RAM, 99 languages
#   large-v3 = best accuracy, ~3 GB RAM, slower first run
WHISPER_ENDPOINT=http://whisper:8000
WHISPER_STT_MODEL=Systran/faster-whisper-medium
WHISPER_COMPUTE_TYPE=int8

# Kokoro TTS — English-optimised (OpenAI-compatible /v1/audio/speech)
# Docker: http://kokoro:8880  |  Local dev: http://localhost:8880
# To use Kokoro as the meeting-agent /say TTS: set SUPERTONIC_URL=http://kokoro:8880
KOKORO_ENDPOINT=http://kokoro:8880

# XTTS v2 TTS — 17 languages, self-hosted (Coqui XTTS v2 API server)
# Docker (voice profile): http://xtts:5002  host port: 5004  |  Local dev: http://localhost:5004
# Activated automatically when --profile voice is used. Model download ~2 GB on first boot.
XTTS_ENDPOINT=http://xtts:5002

# Meta MMS-TTS — 1100+ languages, self-hosted (facebook/mms-tts-* models via HuggingFace)
# Docker (voice profile): http://mms-tts:5002  host port: 5005  |  Local dev: http://localhost:5005
# Activated automatically when --profile voice is used. Models download per-language (~30-100 MB each).
MMS_TTS_ENDPOINT=http://mms-tts:5002

# -----------------------------------------------------------------------------
# Meeting Platform Native SDK Credentials
# -----------------------------------------------------------------------------

# Microsoft Teams — Graph API Calling Bot
# Azure AD app with permissions: Calls.JoinGroupCall.All, OnlineMeetings.ReadWrite.All
# Docs: https://learn.microsoft.com/en-us/graph/api/application-post-calls
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_BOT_DISPLAY_NAME=AgentFarm Bot

# teams-media-bot sidecar (voice profile) — applicationHostedMediaConfig + FFmpeg video relay.
# Docker (voice profile): http://teams-media-bot:8090  host port: 8090
# When set, TeamsJoinAdapter.join() uses applicationHostedMediaConfig (real media endpoint)
# instead of serviceHostedMediaConfig (audio only). startScreenShare() relays the desktop-agent
# HLS stream to Teams via the sidecar's RTP relay pipeline.
TEAMS_MEDIA_BOT_URL=http://teams-media-bot:8090

# Public HTTPS URL Teams can reach the sidecar on for ICE/DTLS negotiation callbacks.
# Required for video injection to work end-to-end.
# Dev: run scripts/voice-dev.sh (or .ps1) — it starts ngrok and injects the URL automatically.
# Prod: set to your Azure Relay or stable HTTPS hostname.
# Example: https://abc123.ngrok-free.app
TEAMS_CALLBACK_BASE_URL=

# ngrok auth token — required by the ngrok sidecar in the voice docker compose profile.
# Free account: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Zoom — Server-to-Server OAuth app (marketplace.zoom.us)
# Required scopes: meeting:write:admin, meeting:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# zoom-video-sidecar (voice profile) — Playwright browser session + xdotool screen share.
# Docker (voice profile): http://zoom-video-sidecar:8091  host port: 8091
# When set, ZoomJoinAdapter delegates join() + startScreenShare() to the sidecar.
# The sidecar uses the desktop-agent's existing Chromium to join and share the screen.
ZOOM_VIDEO_SIDECAR_URL=http://zoom-video-sidecar:8091

# Optional bearer token to protect the sidecar's inbound API (set on both sides).
ZOOM_SIDECAR_TOKEN=

# FreeSWITCH SIP — universal audio-only join for any meeting platform
# Docker (voice profile): freeswitch:8021  |  External: your-host:8021
# ESL password must match the value set in FREESWITCH_ESL_PASSWORD.
# WARNING: change ClueCon before exposing port 8021 outside the Docker network.
FREESWITCH_ESL_HOST=freeswitch
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon
FREESWITCH_SIP_PROFILE=external

# -----------------------------------------------------------------------------
# Browser Agent
# -----------------------------------------------------------------------------

# Base URL of the browser-agent Flask service (Playwright + optional Claude brain)
BROWSER_AGENT_URL=http://browser-agent:5002

# Anthropic API key — optional; if set, the browser-agent uses Claude claude-3-haiku
# to intelligently plan browser actions. Leave blank to use simple navigate+extract mode.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------

# Stripe secret key (use sk_test_* for development)
STRIPE_SECRET_KEY=your-secret-here

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=your-secret-here

# Razorpay webhook signing secret
RAZORPAY_WEBHOOK_SECRET=your-secret-here

# Stripe publishable key (exposed to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-publishable-key-here

# Razorpay key ID
RAZORPAY_KEY_ID=your-secret-here

# Razorpay key secret
RAZORPAY_KEY_SECRET=your-secret-here

# Razorpay key ID exposed to the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-key-id-here

# Zoho Sign OAuth client ID
ZOHO_CLIENT_ID=your-secret-here

# Zoho Sign OAuth client secret
ZOHO_CLIENT_SECRET=your-secret-here

# Zoho Sign webhook verification token
ZOHO_SIGN_WEBHOOK_TOKEN=your-secret-here

# -----------------------------------------------------------------------------
# Shared token AGENTFARM_ prefix aliases
# The base names (APPROVAL_INTAKE_SHARED_TOKEN etc.) are the original keys.
# Code also checks for these AGENTFARM_ prefixed names as canonical forms.
# -----------------------------------------------------------------------------
AGENTFARM_APPROVAL_INTAKE_SHARED_TOKEN=your-secret-here
AGENTFARM_CONNECTOR_EXEC_SHARED_TOKEN=your-secret-here
AGENTFARM_RUNTIME_DECISION_SHARED_TOKEN=your-secret-here
AGENTFARM_RUNTIME_TASK_SHARED_TOKEN=your-secret-here
AF_RUNTIME_DISPATCH_SHARED_TOKEN=your-secret-here
AF_RUNTIME_TASK_SHARED_TOKEN=your-secret-here

# =============================================================================
# Costs & Spending Limits  (items 26–29)
# Set ALL of these before launch. None of the paid services below auto-stop;
# the limits must come from you.
# =============================================================================

# -----------------------------------------------------------------------------
# Billing alert target
# -----------------------------------------------------------------------------

# Email address (or alias) that receives budget warnings and token-exhaustion alerts.
# Route this to a mailbox that pushes a phone notification — not an inbox you check
# weekly. Budget alerts in the middle of the night are useless if you see them Monday.
BILLING_ALERT_EMAIL=billing-alerts@yourdomain.com

# -----------------------------------------------------------------------------
# External service spending limits  (set these in each provider's dashboard)
# -----------------------------------------------------------------------------
# These variables are reference documentation only — the actual caps are configured
# in the provider's billing/quota portal. Record the values you set here so they
# are visible in version control alongside the code that calls each service.

# OpenAI / Azure OpenAI: set a hard monthly limit in platform.openai.com → Billing → Limits
# or via the Azure Cost Management budget in the resource group.
# OPENAI_MONTHLY_HARD_LIMIT_USD=50

# Anthropic: set a monthly hard limit in console.anthropic.com → Plans & Billing
# ANTHROPIC_MONTHLY_HARD_LIMIT_USD=50

# Twilio: set a balance alarm in console.twilio.com → Account → Balance Alerts
# TWILIO_MONTHLY_HARD_LIMIT_USD=20

# SendGrid / Twilio SendGrid: set a sending limit in app.sendgrid.com → Settings → Mail Settings
# SENDGRID_MONTHLY_SEND_LIMIT=50000

# AWS: create a Billing Alarm in CloudWatch (SNS → email) and a Cost Budget with
# an "Absolute budget" action that stops services when exceeded.
# AWS_MONTHLY_HARD_LIMIT_USD=100

# Google Cloud: set a budget with "stop billing" action in console.cloud.google.com → Billing → Budgets
# GCP_MONTHLY_HARD_LIMIT_USD=100

# -----------------------------------------------------------------------------
# dashboard — additional vars
# -----------------------------------------------------------------------------

# Bearer token used by Next.js proxy routes to authenticate to the API gateway
DASHBOARD_API_TOKEN=your-secret-here

# Base URL of the agent-runtime (used by browser-side dashboard polling)
AGENT_RUNTIME_BASE_URL=http://localhost:3001

# Bearer token used by dashboard to authenticate to the agent-runtime
AGENT_RUNTIME_TOKEN=your-secret-here

# Local directory for persisted dashboard state
AF_DASHBOARD_STATE_DIR=./data/dashboard-state

# Number of evidence items per page in the approval evidence view
NEXT_PUBLIC_APPROVAL_EVIDENCE_PAGINATION=20

# -----------------------------------------------------------------------------
# website — additional vars
# -----------------------------------------------------------------------------

# Externally reachable base URL of the website app
WEBSITE_BASE_URL=http://localhost:3002

# Path to the SQLite database used for website auth sessions
WEBSITE_AUTH_DB_PATH=./data/website-auth.db

# Public base URL exposed to browser-side website code
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Waitlist provider: "formspree" or "none"
NEXT_PUBLIC_WAITLIST_PROVIDER=formspree

# Formspree form ID for the waitlist signup form
NEXT_PUBLIC_FORMSPREE_ID=change-me

# -----------------------------------------------------------------------------
# agent-runtime — local workspace actions
# -----------------------------------------------------------------------------

# Base directory for local workspace operations
AF_WORKSPACE_BASE=./workspace

# Comma-separated list of allowed local applications for workspace actions
AF_LOCAL_ALLOWED_APPS=vscode,terminal

# Comma-separated list of allowed meeting hosts for local workspace actions
AF_LOCAL_ALLOWED_MEETING_HOSTS=meet.google.com,zoom.us

# =============================================================================
# Environments & Deployment (items 30–35)
# =============================================================================

# Set to "production" in production and "staging" in staging.
# Never run staging or production with "development" — it enables stack traces,
# verbose logs, and other debug features that leak internals to attackers.
NODE_ENV=development

# Set to "true" to serve a 503 maintenance page for all traffic except /api/health.
# Flip this in the hosting dashboard (Vercel env var override) without redeploying.
# PRODUCTION: set to false; change to true only during planned maintenance windows.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Your production domain — used for HTTPS redirects, CORS lock, HSTS, and cookie domain.
# Example: APP_DOMAIN=agentfarm.ai
APP_DOMAIN=localhost

# =============================================================================
# Logging & Observability (items 36–38)
# =============================================================================

# Sentry DSN — paste the DSN from sentry.io after creating a project.
# Errors and exceptions are captured here instead of leaking to the browser.
# Leave empty in local dev; required in staging and production.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment tag. Set to "staging" or "production" accordingly.
SENTRY_ENVIRONMENT=development

# Log retention: ensure your log sink (Datadog, Papertrail, Logtail, CloudWatch)
# retains at least 30 days. This is a documentation reminder — not a code flag.
# AF_LOG_RETENTION_DAYS=30 (configure in your log provider's settings)

# -----------------------------------------------------------------------------
# Smoke tests (AF_DB_SMOKE_* — not needed in production)
# -----------------------------------------------------------------------------
AF_DB_SMOKE_APPROVAL_API_URL=http://localhost:3000
AF_DB_SMOKE_BOT_ID=smoke-bot-id
AF_DB_SMOKE_CORRELATION_ID=smoke-correlation-id
AF_DB_SMOKE_EVIDENCE_API_URL=http://localhost:3003
AF_DB_SMOKE_HEALTH_PORT=9999
AF_DB_SMOKE_LOG_LEVEL=info
AF_DB_SMOKE_POLICY_PACK_VERSION=1.0.0
AF_DB_SMOKE_ROLE_PROFILE=developer
AF_DB_SMOKE_RUNTIME_CONTRACT_VERSION=1.0.0
AF_DB_SMOKE_TENANT_ID=smoke-tenant-id
AF_DB_SMOKE_WORKSPACE_ID=smoke-workspace-id

# -----------------------------------------------------------------------------
# AgentFarm Support Agent
# -----------------------------------------------------------------------------
# Workspace and bot IDs for the agentfarm-support agent.
SUPPORT_AGENT_WORKSPACE_ID=your-support-workspace-id
SUPPORT_AGENT_BOT_ID=your-support-bot-id

# The bot IDs of downstream agents that the support agent dispatches to.
# Required for Tier 2 (code fixes) and Tier 3 (infra fixes) escalation paths.
DEVELOPER_AGENT_BOT_ID=your-developer-agent-bot-id
DEVOPS_AGENT_BOT_ID=your-devops-agent-bot-id

# Optional escalation channels. At least one must be set for Tier 4 escalation.
# If neither is set, escalations are logged only (no external notification).
MCP_SLACK_URL=http://slack-mcp:9000
MCP_PAGERDUTY_URL=http://pagerduty-mcp:9001

# Slack channel for escalation notifications (optional, used by MCP_SLACK_URL).
SUPPORT_SLACK_CHANNEL=#platform-incidents

# PagerDuty integration key (optional, used by MCP_PAGERDUTY_URL).
SUPPORT_PAGERDUTY_KEY=your-pagerduty-key

# Proactive platform health monitor (Feature 4).
# Set PROACTIVE_MONITOR_ENABLED=true to activate the background tenant scanner.
# PROACTIVE_MONITOR_INTERVAL_MS controls the scan frequency (default 15 min).
PROACTIVE_MONITOR_ENABLED=false
PROACTIVE_MONITOR_INTERVAL_MS=900000

# Bot ID used by the support agent when raising auto-detected issues.
SUPPORT_BOT_ID=agentfarm-support

# WebSocket session inactivity timeout (ms). Voice and chat sessions are
# terminated server-side after this period with no frames. Default: 10 min.
SUPPORT_SESSION_TIMEOUT_MS=600000

# -----------------------------------------------------------------------------
# Salesforce lead sync (website form submissions)
# -----------------------------------------------------------------------------
# Set SALESFORCE_LEAD_SYNC_ENABLED=true to sync website form leads to Salesforce
SALESFORCE_LEAD_SYNC_ENABLED=false
CRM_VENDOR=salesforce
CRM_ACCESS_TOKEN=your-salesforce-bearer-token
CRM_INSTANCE_URL=https://yourorg.salesforce.com

# -----------------------------------------------------------------------------
# Nurture lead queue worker
# -----------------------------------------------------------------------------
# How often to sweep for due nurture leads (milliseconds). Default: 1 hour.
NURTURE_SWEEP_INTERVAL_MS=3600000
# Booking/calendar link inserted into nurture email bodies.
NURTURE_BOOKING_URL=https://calendly.com/agentfarm
# Set to "true" to dispatch nurture emails. Default: false (logs only).
NURTURE_EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# Booking webhook (Calendly / Cal.com / Microsoft Bookings)
# -----------------------------------------------------------------------------
# Shared HMAC-SHA256 secret used to verify incoming booking webhook payloads.
# Set this in your calendar provider's webhook settings and here.
# REQUIRED in production — if set, a valid x-webhook-signature header is enforced.
BOOKING_WEBHOOK_SECRET=

# Email credentials used by booking-invite-sender and proposal-generator.
# These supplement the provider-specific settings (SMTP / SendGrid / Mailgun).
SALES_FROM_EMAIL=sales@agentfarm.dev
SALES_FROM_NAME=AgentFarm Sales
SALES_EMAIL_API_KEY=
SALES_SMTP_HOST=
SALES_SMTP_PORT=587
SALES_SMTP_SECURE=false
SALES_SMTP_USER=
SALES_SMTP_PASS=

DASHBOARD_URL=https://agentfarm.ai

# -----------------------------------------------------------------------------
# Contract webhook (DocuSign / Zoho Sign / Adobe Sign)
# -----------------------------------------------------------------------------
# HMAC-SHA256 secret for contract webhook signature verification.
CONTRACT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Win/loss notification
# -----------------------------------------------------------------------------
# Provider: slack | teams | email | webhook
WIN_NOTIFICATION_PROVIDER=
# Slack webhook URL, Teams webhook URL, email address, or target URL (for webhook)
WIN_NOTIFICATION_TARGET=
# Shared secret for webhook notifications (HMAC-SHA256 signing)
WIN_NOTIFICATION_SECRET=

# Days after a lost deal before re-engaging the prospect (0 = disabled)
RE_ENGAGE_DAYS_AFTER_LOSS=0

# -----------------------------------------------------------------------------
# Calls webhook (Twilio / SignalWire / Plivo / Vonage telephony callbacks)
# -----------------------------------------------------------------------------
# Shared token sent by your telephony gateway in the x-calls-webhook-token header.
# REQUIRED in production — all three callback routes (answer, turn, status) reject
# requests that do not present a valid token.
CALLS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Customer Portal
# -----------------------------------------------------------------------------
# Base URL of the dashboard/portal app — used to build password-reset links.
PORTAL_APP_BASE_URL=http://localhost:3001

# --- Email delivery for password-reset ---
# Option 1 (recommended): Resend — https://resend.com — set your API key here.
RESEND_API_KEY=

# Option 2: generic webhook — POST the reset details to this URL.
PORTAL_RESET_WEBHOOK_URL=

# From address used in portal emails (default: noreply@agentfarm.io).
PORTAL_EMAIL_FROM=AgentFarm Support <noreply@agentfarm.io>
