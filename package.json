{
    "name": "agentfarm",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@9.12.0",
    "scripts": {
        "build": "pnpm -r --if-present build",
        "dev": "pnpm --filter @agentfarm/api-gateway dev",
        "lint": "pnpm -r --if-present lint",
        "test": "pnpm -r --if-present test",
        "typecheck": "pnpm -r --if-present typecheck",
        "test:core": "pnpm --filter @agentfarm/api-gateway test && pnpm --filter @agentfarm/agent-runtime test",
        "loadtest": "node scripts/load-test-fullstack.mjs",
        "loadtest:selftest": "node scripts/load-test-fullstack.mjs --self-test",
        "db:migrate:deploy": "pnpm --filter @agentfarm/db-schema prisma:migrate:deploy",
        "db:backfill:replay": "node scripts/backfill-audit-replay-to-prisma.mjs",
        "test:db-smoke": "pnpm --filter @agentfarm/agent-runtime test:db-smoke",
        "test:db": "bash scripts/run-db-tests.sh",
        "test:db-lane": "pnpm db:migrate:deploy && pnpm test:db-smoke",
        "smoke:e2e": "node scripts/e2e-smoke.mjs",
        "verify:website:prod": "node scripts/website-swa-verify.mjs",
        "quality:gate": "node scripts/quality-gate.mjs"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "c8": "^10.1.3",
        "eslint": "^9.17.0",
        "exceljs": "^4.4.0",
        "prettier": "^3.4.2",
        "prisma": "6.19.3",
        "typescript": "^5.7.2"
    },
    "pnpm": {
        "overrides": {
            "fast-uri": ">=3.1.3",
            "protobufjs": ">=8.6.6",
            "vitest": ">=4.1.8",
            "@grpc/grpc-js": ">=1.14.4",
            "@opentelemetry/core": ">=2.8.0",
            "@opentelemetry/propagator-jaeger": ">=2.9.0",
            "axios": ">=1.18.0",
            "body-parser": ">=2.3.0",
            "brace-expansion": ">=5.0.9",
            "esbuild": ">=0.28.1",
            "nanoid": ">=3.3.18",
            "nodemailer": ">=9.0.1",
            "pdfjs-dist": ">=6.2.108",
            "find-my-way": ">=9.7.0",
            "form-data": ">=4.0.6",
            "ip-address": ">=10.3.1",
            "js-yaml": ">=4.3.0",
            "linkify-it": ">=5.0.2 <6",
            "postcss": ">=8.5.23",
            "qs": ">=6.15.2",
            "sharp": ">=0.35.0",
            "undici": ">=7.29.0",
            "ws": ">=8.21.0"
        }
    }
}