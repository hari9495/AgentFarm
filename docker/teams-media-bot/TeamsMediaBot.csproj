<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TeamsMediaBot</RootNamespace>
    <AssemblyName>TeamsMediaBot</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Graph REST client (control-plane API calls) -->
    <PackageReference Include="Microsoft.Graph" Version="5.56.0" />
    <!-- MSAL — Azure AD client-credentials token acquisition -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.65.0" />
    <!-- BouncyCastle — DTLS-SRTP handshake (RFC 5764) for the media plane.
         Provides DtlsServerProtocol, use_srtp extension, and the keying-material
         exporter used to derive SRTP master key + salt from the DTLS session. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>
</Project>
