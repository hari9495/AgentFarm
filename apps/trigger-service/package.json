        "imapflow": "^1.0.190",
        "mailparser": "^3.9.14",
        "nodemailer": "^8.0.11"
    },
    "devDependencies": {
        "@types/mailparser": "^3.4.6",
        "@types/nodemailer": "^8.0.1",
        "@types/node": "^20.19.43",
        "tsx": "^4.20.6",
        "typescript": "^5.7.2"
    }
}