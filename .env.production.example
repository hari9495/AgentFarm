# =============================================================================
# AgentFarm — PRODUCTION environment variables
# =============================================================================
#
# Usage:
#   1. Copy this file to .env on your production server (never commit .env).
#   2. Replace every <GENERATE> with:  openssl rand -base64 32
#   3. Replace every <REQUIRED:…> with the real value for your environment.
#   4. Values marked <OPTIONAL> can be left empty to disable that feature.
#
# Naming:
#   development  → database  agentfarm     (or agentfarm_dev)
#   production   → database  agentfarm_prod
#
# Domain used in this file: agentfarms.in  (change to your domain).
# =============================================================================

NODE_ENV=production

# =============================================================================
# Infrastructure
# =============================================================================

# PostgreSQL — always add ?sslmode=require in production.
# pgvector extension must be enabled on the server (needed by all 15 agents).
DATABASE_URL=postgresql://agentfarm:<REQUIRED:DB_PASSWORD>@<REQUIRED:DB_HOST>:5432/agentfarm_prod?sslmode=require
POSTGRES_PASSWORD=<REQUIRED:DB_PASSWORD>

# Redis — use a dedicated prod instance (Upstash recommended; 1 env var).
REDIS_URL=redis://:<REQUIRED:REDIS_PASSWORD>@<REQUIRED:REDIS_HOST>:6379/0

# OPA (Open Policy Agent)
OPA_BASE_URL=http://localhost:8181

# =============================================================================
# api-gateway  (port 3000)
# =============================================================================

API_GATEWAY_PORT=3000
API_REQUIRE_AUTH=true

# Min 64 chars — generate: openssl rand -base64 64
API_SESSION_SECRET=<GENERATE>

# AES-256-GCM key for sensitive DB columns. Min 32 chars.
# Run scripts/migrate-encrypt-fields.ts after setting for the first time.
FIELD_ENCRYPTION_KEY=<GENERATE>

# AES-256-GCM key for TOTP secrets. Min 32 chars.
MFA_ENCRYPTION_KEY=<GENERATE>
MFA_ISSUER=AgentFarm

# Exact production origins — never use * in production.
ALLOWED_ORIGINS=https://agentfarms.in,https://dashboard.agentfarms.in

APP_DOMAIN=agentfarms.in

# Bearer token for /ops/monitoring endpoints
OPS_MONITORING_TOKEN=<GENERATE>

# External plugins — keep false unless you have a full plugin review process
FEATURE_EXTERNAL_PLUGIN_LOADING=false

# Internal service URLs (Docker internal or private network hostnames)
ORCHESTRATOR_API_BASE_URL=http://orchestrator:3011
AGENT_RUNTIME_URL=http://agent-runtime:4000
SSE_PUSH_URL=http://dashboard:3001/sse-push

# Persistent orchestrator state (must survive container restarts)
ORCHESTRATOR_STATE_PATH=/data/orchestrator/state.json

# =============================================================================
# Inter-service HMAC shared tokens — ALL must be set; ALL must be distinct.
# Generate each with: openssl rand -base64 32
# =============================================================================

RUNTIME_SERVICE_TOKEN=<GENERATE>
APPROVAL_INTAKE_SHARED_TOKEN=<GENERATE>
AGENTFARM_APPROVAL_INTAKE_SHARED_TOKEN=<GENERATE>      # same value as above
RUNTIME_DECISION_SHARED_TOKEN=<GENERATE>
AGENTFARM_RUNTIME_DECISION_SHARED_TOKEN=<GENERATE>     # same value as above
CONNECTOR_EXEC_SHARED_TOKEN=<GENERATE>
AGENTFARM_CONNECTOR_EXEC_SHARED_TOKEN=<GENERATE>       # same value as above
RUNTIME_DISPATCH_SHARED_TOKEN=<GENERATE>
AF_RUNTIME_DISPATCH_SHARED_TOKEN=<GENERATE>            # same value as above
RUNTIME_TASK_SHARED_TOKEN=<GENERATE>
AF_RUNTIME_TASK_SHARED_TOKEN=<GENERATE>                # same value as above
AGENTFARM_RUNTIME_TASK_SHARED_TOKEN=<GENERATE>         # same value as above
PASSWORDLESS_LOGIN_SHARED_TOKEN=<GENERATE>
SSE_INTERNAL_TOKEN=<GENERATE>
EVIDENCE_SERVICE_TOKEN=<GENERATE>
MEETING_SERVICE_TOKEN=<GENERATE>

# =============================================================================
# Webhook secrets — REQUIRED in production (fail-closed if set).
# Each protects its endpoint against spoofed inbound payloads.
# Set each one in the corresponding provider's webhook settings AND here.
# =============================================================================

WEBHOOK_INGEST_SECRET=<GENERATE>
SLACK_WEBHOOK_SECRET=<GENERATE>
TEAMS_WEBHOOK_SECRET=<GENERATE>
MEMORY_WEBHOOK_SECRET=<GENERATE>
ZOHO_SIGN_WEBHOOK_TOKEN=<GENERATE>
BOOKING_WEBHOOK_SECRET=<GENERATE>
CONTRACT_WEBHOOK_SECRET=<GENERATE>
CALLS_WEBHOOK_SECRET=<GENERATE>
WEBHOOK_HMAC_SECRET=<GENERATE>

# Win/loss notification webhook secret
WIN_NOTIFICATION_SECRET=<GENERATE>

# =============================================================================
# agent-runtime  (port 4000)
# =============================================================================

RUNTIME_PORT=4000
RUNTIME_BASE_URL=https://runtime.agentfarms.in

AF_TENANT_ID=<REQUIRED:TENANT_ID>
AGENT_TENANT_ID=<REQUIRED:TENANT_ID>
AF_WORKSPACE_ID=<REQUIRED:WORKSPACE_ID>
AF_BOT_ID=<REQUIRED:BOT_ID>
AF_ROLE_PROFILE=Developer Agent
AF_POLICY_PACK_VERSION=mvp-v1
AF_LOG_LEVEL=warn
AF_RUNTIME_CONTRACT_VERSION=1.0
AF_ENFORCE_TASK_LEASE=true
AF_TASK_LEASE_TTL_SECONDS=300

AF_APPROVAL_API_URL=http://api-gateway:3000
API_GATEWAY_URL=http://api-gateway:3000
AF_EVIDENCE_API_URL=http://api-gateway:3000
EVIDENCE_SERVICE_URL=http://api-gateway:3000
AGENT_DISPATCH_URL=http://dashboard:3001/dispatch

# Token budget — tune per agent. 500 000 tokens/day ≈ 1 000 typical tasks.
AF_TOKEN_BUDGET_DAILY_LIMIT=500000
AF_TOKEN_BUDGET_WARNING_THRESHOLD=0.8
AF_TOKEN_BUDGET_CRITICAL_THRESHOLD=0.9
BUDGET_ALERT_WARN_PCT=80
BUDGET_ALERT_CRITICAL_PCT=90
BUDGET_ALERT_EXCEEDED_PCT=100
BILLING_ALERT_EMAIL=<REQUIRED:ALERT_EMAIL>

# Health / observability
AF_HEALTH_PORT=4000
AGENT_OBSERVABILITY_BLOB_ACCOUNT_URL=https://<REQUIRED:STORAGE_ACCOUNT>.blob.core.windows.net
AGENT_OBSERVABILITY_BLOB_CONTAINER=agentfarm-observability
AGENT_OBSERVABILITY_BLOB_WRITE_SAS_TOKEN=<REQUIRED:SAS_WRITE>
AGENT_OBSERVABILITY_BLOB_READ_SAS_TOKEN=<REQUIRED:SAS_READ>

# Desktop operator (set to playwright for headless server environments)
DESKTOP_OPERATOR=playwright
BROWSER_PROFILE_DIR=/data/browser-profiles

# =============================================================================
# LLM Providers — set AF_MODEL_PROVIDER to activate one.
# Providers: openai | anthropic | azure_openai | google | xai | mistral |
#            together | deepseek | github_models
# =============================================================================

AF_MODEL_PROVIDER=anthropic
AF_LLM_TIMEOUT_MS=120000

# --- Anthropic (default) ---
AF_ANTHROPIC_API_KEY=<REQUIRED:ANTHROPIC_API_KEY>
AF_ANTHROPIC_MODEL=claude-sonnet-4-6
AF_ANTHROPIC_MODEL_QUALITY_FIRST=claude-opus-4-7
AF_ANTHROPIC_MODEL_COST_BALANCED=claude-sonnet-4-6
AF_ANTHROPIC_MODEL_SPEED_FIRST=claude-haiku-4-5

# --- OpenAI ---
AF_OPENAI_API_KEY=<OPTIONAL>
AF_OPENAI_BASE_URL=https://api.openai.com/v1
AF_OPENAI_MODEL_QUALITY_FIRST=gpt-4o
AF_OPENAI_MODEL_COST_BALANCED=gpt-4o
AF_OPENAI_MODEL_SPEED_FIRST=gpt-4o-mini

# --- NVIDIA Build (OpenAI-compatible, 1000 free calls/month per model) ---
# To activate: set AF_MODEL_PROVIDER=openai and point AF_OPENAI_BASE_URL here.
# Get API key: https://build.nvidia.com → Sign In → API Keys
# AF_OPENAI_API_KEY=nvapi-<REQUIRED:NVIDIA_API_KEY>
# AF_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# AF_OPENAI_MODEL_QUALITY_FIRST=nvidia/llama-3.1-nemotron-ultra-253b-v1
# AF_OPENAI_MODEL_COST_BALANCED=nvidia/llama-3.3-nemotron-super-49b-v1
# AF_OPENAI_MODEL_SPEED_FIRST=microsoft/phi-4-mini-instruct

# --- Azure OpenAI ---
AF_AZURE_OPENAI_ENDPOINT=<OPTIONAL>
AF_AZURE_OPENAI_API_KEY=<OPTIONAL>
AF_AZURE_OPENAI_DEPLOYMENT=gpt-4o
AF_AZURE_OPENAI_API_VERSION=2024-06-01

# --- Google AI ---
AF_GOOGLE_API_KEY=<OPTIONAL>
AF_GOOGLE_MODEL_QUALITY_FIRST=gemini-1.5-pro
AF_GOOGLE_MODEL_SPEED_FIRST=gemini-1.5-flash

# --- xAI ---
AF_XAI_API_KEY=<OPTIONAL>
AF_XAI_MODEL=grok-beta

# --- Mistral ---
AF_MISTRAL_API_KEY=<OPTIONAL>
AF_MISTRAL_MODEL_QUALITY_FIRST=mistral-large-latest
AF_MISTRAL_MODEL_SPEED_FIRST=mistral-small-latest

# --- Together AI ---
AF_TOGETHER_API_KEY=<OPTIONAL>
AF_TOGETHER_MODEL_QUALITY_FIRST=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
AF_TOGETHER_MODEL_SPEED_FIRST=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# --- DeepSeek ---
AF_DEEPSEEK_API_KEY=<OPTIONAL>
AF_DEEPSEEK_BASE_URL=https://api.deepseek.com
AF_DEEPSEEK_MODEL_QUALITY_FIRST=deepseek-reasoner
AF_DEEPSEEK_MODEL_COST_BALANCED=deepseek-chat
AF_DEEPSEEK_MODEL_SPEED_FIRST=deepseek-chat

# --- Chat LLM (Agent Chat feature) ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<REQUIRED:OPENAI_API_KEY>
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# =============================================================================
# trigger-service  (port 3002)
# =============================================================================

TRIGGER_SERVICE_PORT=3002
TRIGGER_TENANT_ID=<REQUIRED:TENANT_ID>
TRIGGER_DEFAULT_AGENT_ID=default-agent
ANTHROPIC_API_KEY=<REQUIRED:ANTHROPIC_API_KEY>
ANTHROPIC_API_VERSION=2023-06-01

# Email trigger (IMAP polling — leave empty to disable)
EMAIL_IMAP_HOST=<OPTIONAL>
EMAIL_IMAP_PORT=993
EMAIL_IMAP_TLS=true
EMAIL_IMAP_USER=<OPTIONAL>
EMAIL_IMAP_PASSWORD=<OPTIONAL>

# Slack trigger
SLACK_BOT_TOKEN=<OPTIONAL>
SLACK_SIGNING_SECRET=<OPTIONAL>

# =============================================================================
# dashboard  (port 3001)
# =============================================================================

DASHBOARD_API_BASE_URL=http://api-gateway:3000
NEXT_PUBLIC_API_URL=https://api.agentfarms.in
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_APPROVAL_EVIDENCE_PAGINATION=20
DASHBOARD_API_TOKEN=<GENERATE>
AGENT_RUNTIME_BASE_URL=https://runtime.agentfarms.in
AGENT_RUNTIME_TOKEN=<GENERATE>
DASHBOARD_URL=https://agentfarms.in
AF_DASHBOARD_STATE_DIR=/data/dashboard-state
MEETING_AGENT_URL=http://meeting-agent:7799
MEETING_AGENT_TOKEN=<GENERATE>

# =============================================================================
# website  (Cloudflare Workers via OpenNext)
# =============================================================================

WEBSITE_BASE_URL=https://agentfarms.in
NEXT_PUBLIC_SITE_URL=https://agentfarms.in
NEXT_PUBLIC_WAITLIST_PROVIDER=formspree
NEXT_PUBLIC_FORMSPREE_ID=<REQUIRED:FORMSPREE_FORM_ID>
AGENTFARM_INTERNAL_DASHBOARD_URL=https://dashboard.agentfarms.in

# Signup access control
AGENTFARM_SUPERADMIN_EMAILS=<REQUIRED:YOUR_EMAIL>
AGENTFARM_SUPERADMIN_DOMAINS=
AGENTFARM_ADMIN_EMAILS=
AGENTFARM_ADMIN_DOMAINS=
AGENTFARM_COMPANY_EMAILS=
AGENTFARM_COMPANY_DOMAINS=<REQUIRED:YOUR_COMPANY_DOMAIN>
AGENTFARM_DISABLE_COMPANY_FALLBACK=true
AGENTFARM_ALLOWED_SIGNUP_EMAILS=
AGENTFARM_ALLOWED_SIGNUP_DOMAINS=

# Internal login access control
API_INTERNAL_LOGIN_ALLOWED_DOMAINS=agentfarms.in
API_INTERNAL_LOGIN_ADMIN_ROLES=admin

# =============================================================================
# Observability & Error Tracking
# =============================================================================

SENTRY_DSN=<REQUIRED:SENTRY_DSN>
NEXT_PUBLIC_SENTRY_DSN=<REQUIRED:SENTRY_DSN>
SENTRY_ENVIRONMENT=production

APPLICATIONINSIGHTS_CONNECTION_STRING=<OPTIONAL:AZURE_APP_INSIGHTS_CONNECTION_STRING>
OTEL_EXPORTER_OTLP_ENDPOINT=<OPTIONAL>

AZURE_BLOB_CONNECTION_STRING=<OPTIONAL:AZURE_STORAGE_CONNECTION_STRING>
AZURE_BLOB_CONTAINER_NAME=agentfarm-audit
AZURE_BLOB_EVIDENCE_CONTAINER_NAME=agentfarm-evidence

# =============================================================================
# Notifications
# =============================================================================

NOTIFICATION_CHANNEL=slack
NOTIFICATION_SLACK_WEBHOOK_URL=<REQUIRED:SLACK_WEBHOOK_URL>
NOTIFICATION_TEAMS_WEBHOOK_URL=<OPTIONAL>
NOTIFICATION_EMAIL_TO=<OPTIONAL>
NOTIFICATION_EMAIL_FROM=<OPTIONAL>
NOTIFICATION_SMTP_HOST=<OPTIONAL>
NOTIFICATION_SMTP_PORT=587

AGENT_QUESTION_SLACK_WEBHOOK_URL=<REQUIRED:SLACK_WEBHOOK_URL>
MEETING_SLACK_DISTRIBUTION=false
MEETING_SLACK_WEBHOOK_URL=<OPTIONAL>

# =============================================================================
# Email / SMTP
# =============================================================================

SMTP_HOST=<REQUIRED:SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<REQUIRED:SMTP_USER>
SMTP_PASS=<REQUIRED:SMTP_PASS>
SMTP_FROM=noreply@agentfarms.in

SALES_EMAIL_FROM=sales@agentfarms.in
SALES_EMAIL_FROM_NAME=AgentFarm Sales
SALES_FROM_EMAIL=sales@agentfarms.in
SALES_FROM_NAME=AgentFarm Sales
SALES_EMAIL_API_KEY=<OPTIONAL>
SALES_SMTP_HOST=<OPTIONAL>
SALES_SMTP_PORT=587
SALES_SMTP_SECURE=false
SALES_SMTP_USER=<OPTIONAL>
SALES_SMTP_PASS=<OPTIONAL>
SENDGRID_API_KEY=<OPTIONAL>
MAILGUN_API_KEY=<OPTIONAL>

# Password-reset email delivery (Resend recommended)
RESEND_API_KEY=<REQUIRED:RESEND_API_KEY>
PORTAL_EMAIL_FROM=AgentFarm Support <noreply@agentfarms.in>
PORTAL_APP_BASE_URL=https://agentfarms.in

# =============================================================================
# Payments
# =============================================================================

STRIPE_SECRET_KEY=<REQUIRED:sk_live_...>
STRIPE_WEBHOOK_SECRET=<REQUIRED:whsec_...>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<REQUIRED:pk_live_...>

RAZORPAY_KEY_ID=<OPTIONAL>
RAZORPAY_KEY_SECRET=<OPTIONAL>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<OPTIONAL>
RAZORPAY_WEBHOOK_SECRET=<OPTIONAL>

# =============================================================================
# Connectors / Integrations
# =============================================================================

# Zoho Sign
ZOHO_CLIENT_ID=<OPTIONAL>
ZOHO_CLIENT_SECRET=<OPTIONAL>

# Salesforce CRM
SALESFORCE_LEAD_SYNC_ENABLED=false
CRM_VENDOR=salesforce
CRM_ACCESS_TOKEN=<OPTIONAL>
CRM_INSTANCE_URL=<OPTIONAL>

# Win/loss notifications
WIN_NOTIFICATION_PROVIDER=slack
WIN_NOTIFICATION_TARGET=<OPTIONAL:SLACK_WEBHOOK_URL>
RE_ENGAGE_DAYS_AFTER_LOSS=30

# Booking / calendar
NURTURE_SWEEP_INTERVAL_MS=3600000
NURTURE_BOOKING_URL=https://calendly.com/<REQUIRED:YOUR_CALENDLY>
NURTURE_EMAIL_ENABLED=true

# =============================================================================
# Meeting Platforms
# =============================================================================

# Microsoft Teams
TEAMS_TENANT_ID=<OPTIONAL>
TEAMS_CLIENT_ID=<OPTIONAL>
TEAMS_CLIENT_SECRET=<OPTIONAL>
TEAMS_BOT_APP_ID=<OPTIONAL>
TEAMS_BOT_APP_PASSWORD=<OPTIONAL>
TEAMS_BOT_DISPLAY_NAME=AgentFarm Bot
TEAMS_CALLBACK_BASE_URL=https://teams-callback.agentfarms.in

# Zoom
ZOOM_ACCOUNT_ID=<OPTIONAL>
ZOOM_CLIENT_ID=<OPTIONAL>
ZOOM_CLIENT_SECRET=<OPTIONAL>

# FreeSWITCH SIP (voice profile)
FREESWITCH_ESL_HOST=freeswitch
FREESWITCH_ESL_PORT=8021
# CRITICAL: change ClueCon before exposing port 8021 outside Docker network
FREESWITCH_ESL_PASSWORD=<REQUIRED:CHANGE_FROM_DEFAULT>
FREESWITCH_SIP_PROFILE=external

# =============================================================================
# Sales Agent — Lead Sources
# =============================================================================

APOLLO_API_KEY=<OPTIONAL>
HUNTER_API_KEY=<OPTIONAL>
LINKEDIN_API_KEY=<OPTIONAL>
CLEARBIT_API_KEY=<OPTIONAL>
ZOOMINFO_CLIENT_ID=<OPTIONAL>
ZOOMINFO_CLIENT_SECRET=<OPTIONAL>
ZOOMINFO_API_KEY=<OPTIONAL>
LUSHA_API_KEY=<OPTIONAL>
PHANTOMBUSTER_API_KEY=<OPTIONAL>
PHANTOMBUSTER_AGENT_ID=<OPTIONAL>

# =============================================================================
# Support Agent
# =============================================================================

SUPPORT_AGENT_WORKSPACE_ID=<REQUIRED:WORKSPACE_ID>
SUPPORT_AGENT_BOT_ID=agentfarm-support
SUPPORT_BOT_ID=agentfarm-support
DEVELOPER_AGENT_BOT_ID=<REQUIRED:DEVELOPER_BOT_ID>
DEVOPS_AGENT_BOT_ID=<REQUIRED:DEVOPS_BOT_ID>
SUPPORT_SLACK_CHANNEL=#platform-incidents
SUPPORT_PAGERDUTY_KEY=<OPTIONAL>
PROACTIVE_MONITOR_ENABLED=true
PROACTIVE_MONITOR_INTERVAL_MS=900000
SUPPORT_SESSION_TIMEOUT_MS=600000

# =============================================================================
# Voice (self-hosted — COMPOSE_PROFILES=voice)
# =============================================================================

COMPOSE_PROFILES=
VOICEBOX_URL=http://voicebox:17493
VOXCPM2_URL=http://voxcpm2:8765
WHISPER_ENDPOINT=http://whisper:8000
WHISPER_STT_MODEL=Systran/faster-whisper-medium
WHISPER_COMPUTE_TYPE=int8
KOKORO_ENDPOINT=http://kokoro:8880
XTTS_ENDPOINT=http://xtts:5002
MMS_TTS_ENDPOINT=http://mms-tts:5002

# =============================================================================
# Workspace / Local Actions
# =============================================================================

AF_WORKSPACE_BASE=/data/workspace
AF_LOCAL_ALLOWED_APPS=vscode,terminal
AF_LOCAL_ALLOWED_MEETING_HOSTS=meet.google.com,zoom.us
AF_TOKEN_BUDGET_STATE_PATH=/data/token-budget-state.json
AGENT_OBSERVABILITY_DB_PATH=/data/observability.db
WEBSITE_AUTH_DB_PATH=/data/website-auth.db
