// ── Sprint 20 — AgentFarm Support Agent ──────────────────────────────────────

model SupportIssue {
  id               String                  @id @default(cuid())
  tenantId         String
  workspaceId      String?
  title            String
  description      String
  status           SupportIssueStatus      @default(open)
  severity         SupportIssueSeverity    @default(medium)
  source           SupportIssueSource      @default(operator)
  tierReached      Int?
  fixApplied       Boolean                 @default(false)
  diagnosisReport  Json?
  resolutionNotes  String?
  escalatedTo      String?
  prUrl            String?
  createdAt        DateTime                @default(now())
  resolvedAt       DateTime?
  steps            SupportDiagnosisStep[]
  messages         SupportChatMessage[]
  csatResponse     SupportCsatResponse?

  @@index([tenantId])
  @@index([tenantId, status])
}

model SupportCsatResponse {
  id          String    @id @default(cuid())
  issueId     String    @unique
  token       String    @unique
  rating      Int?
  comment     String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  issue SupportIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([token])
}

model SupportChatMessage {
  id        String   @id @default(cuid())
  issueId   String
  role      String   // 'user' | 'agent' | 'step' | 'fix' | 'error'
  content   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  issue     SupportIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([issueId, createdAt])
}

model SupportDiagnosisStep {
  id          String          @id @default(cuid())
  issueId     String
  stepType    String
  description String
  status      DiagnosisStepStatus @default(pending)
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now())
  issue       SupportIssue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

enum SupportIssueStatus {
  open
  diagnosing
  fixing
  escalated
  resolved
}

enum SupportIssueSeverity {
  critical
  high
  medium
  low
}

enum SupportIssueSource {
  portal
  operator
}

enum DiagnosisStepStatus {
  pending
  running
  done
  failed
}

