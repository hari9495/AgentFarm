// ── Inbound webhook models ────────────────────────────────────────────────────

model WebhookSource {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  secret      String
  // How inbound events are authenticated: "hmac" (default — require a valid
  // HMAC-SHA256 signature over the body) or "none" (accept any POST to the
  // source URL; for services that cannot sign their webhooks).
  verificationMode String @default("hmac")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events InboundWebhookEvent[]

  @@index([tenantId])
}

model InboundWebhookEvent {
  id         String   @id @default(cuid())
  tenantId   String
  sourceId   String
  headers    Json     @default("{}")
  body       Json     @default("{}")
  method     String   @default("POST")
  status     String   @default("processed")
  receivedAt DateTime @default(now())

  source WebhookSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sourceId])
  @@index([receivedAt])
}

// Maps an inbound webhook event to an automatically-enqueued agent task.
// When an event arrives, every enabled rule for the tenant whose source and
// filter match the event enqueues a task (via the normal task queue, so risk
// classification + approval still apply) for the chosen bot/agent.
model WebhookTriggerRule {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  // null = applies to events from any source in the tenant
  sourceId    String?
  name        String
  enabled     Boolean  @default(true)
  // Match conditions (all optional; an empty rule matches every event).
  // matchEventType compares to the event-type header (x-github-event etc.);
  // matchField is a dot-path into the JSON body that must equal matchValue.
  matchEventType String?
  matchField     String?
  matchValue     String?
  // Action: which agent runs, and the instruction it receives. The template
  // supports {{dot.path}} placeholders filled from the event body.
  botId          String
  promptTemplate String
  priority       String   @default("normal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([sourceId])
}

// Sprint 9 — Semantic Memory / Company Knowledge RAG
model TaskTemplate {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  category       String
  agentRole      String
  promptTemplate String
  inputSchema    Json     @default("[]")
  exampleInputs  Json     @default("{}")
  tags           Json     @default("[]")
  isBuiltIn      Boolean  @default(false)
  tenantId       String?
  useCount       Int      @default(0)
  estimatedTime  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([agentRole])
  @@index([tenantId])
}

model AgentKnowledgeBase {
  id             String   @id @default(cuid())
  tenantId       String
  botId          String?
  content        String
  sourceUrl      String?
  sourceType     String
  embeddingModel String?
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([botId])
}

