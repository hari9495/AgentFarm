{
    "name": "@agentfarm/website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack -p 3002",
        "build": "next build",
        "build:cf": "opennextjs-cloudflare build",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "start": "next start -p 3002",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test:permissions": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/permissions.test.ts",
        "test:approvals": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/approvals-flow.test.ts",
        "test:deployments": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/deployments-flow.test.ts",
        "test:deployments:ui": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/deployments-history-ui.test.ts",
        "test:signup": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/signup-flow.test.ts",
        "test:provisioning": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/provisioning-worker.test.ts",
        "test:session-auth": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/session-auth.test.ts",
        "test:provisioning-ui": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/provisioning-progress-ui.test.ts",
        "test:evidence": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/evidence-compliance.test.ts",
        "test:marketplace": "pnpm exec tsx --import ./tests/cloudflare-setup.mts --test tests/marketplace-hire-flow.test.ts",
        "ui:smoke": "node scripts/ui-smoke.mjs",
        "ui:baseline:verify": "node scripts/verify-ui-baseline.mjs",
        "ui:baseline:update": "node scripts/verify-ui-baseline.mjs --update"
    },
    "dependencies": {
        "@agentfarm/auth-utils": "workspace:*",
        "@agentfarm/config": "workspace:*",
        "@agentfarm/connector-contracts": "workspace:*",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.1",
        "@stripe/stripe-js": "^9.4.0",
        "@vercel/analytics": "^2.0.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.36.0",
        "lucide-react": "^0.577.0",
        "motion": "^12.38.0",
        "next": "15.5.19",
        "razorpay": "^2.9.6",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hot-toast": "^2.6.0",
        "stripe": "^22.1.1",
        "tailwind-merge": "^3.5.0",
        "three": "^0.184.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260511.1",
        "@opennextjs/cloudflare": "^1.19.11",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.184.1",
        "eslint": "8.57.0",
        "eslint-config-next": "^15.5.19",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "typescript": "^5",
        "wrangler": "^4.86.0"
    }
}